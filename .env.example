APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost
# Generate this before you do anything else: php artisan key:generate
# The application refuses to serve web requests without a 32 character key.
APP_KEY=
APP_NAME=Bootstrap CMS
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_LOG=daily
# Set to true to write each log line as a single json object (recommended in production)
APP_LOG_JSON=false

# Set to true to suppress desktop notifications from the gulp asset build
DISABLE_NOTIFIER=true

CMS_DESC=Bootstrap CMS is a PHP CMS powered by Laravel 5.
CMS_AUTHOR=Graham Campbell
CMS_NAV=email
# Page bodies are passed to php's eval when this is true, which is arbitrary
# code execution for anyone with edit permission. Leave it off unless this is
# a single author site you fully control.
CMS_EVAL=false
CMS_BLOGGING=true
CMS_EVENTS=true

CONTACT_EMAIL=admin@example.com

CRED_REG=true
CRED_ACTIVATION=true

DB_HOST=localhost
DB_CONNECTION=mysql
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret

CACHE_DRIVER=file
SESSION_DRIVER=file
# Leave this unset to follow APP_URL: the session cookie is marked secure
# whenever APP_URL is https. Only set it to false for local http development.
# SESSION_SECURE=false
QUEUE_DRIVER=sync

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME=null

THEME_NAME=default
THEME_INVERSE=true
